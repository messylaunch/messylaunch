# Messy Launch — environment variables
# Copy this file to .env (local dev) or set these in Vercel (Settings → Environment Variables).
# Every integration is optional — the app degrades gracefully when a key is missing.

# ---- Required ----
# PostgreSQL connection string (Neon, Supabase, or any Postgres)
DATABASE_URL="postgresql://user:pass@host:5432/messylaunch?sslmode=require"

# ---- Auth (magic-link login) ----
# Resend API key — without this, /login shows a dev quick-login picker.
# Get one at https://resend.com → API Keys. Required before real users log in.
RESEND_API_KEY="re_..."

# From address for login emails (defaults to Messy Launch <onboarding@resend.dev>)
# AUTH_EMAIL_FROM="Messy Launch <hello@your-domain.com>"

# Base URL for magic links (defaults to http://localhost:3000 in dev)
# APP_URL="https://messylaunch.com"

# Force dev auth mode on Vercel (set to "1" for staging/demo deploys)
# AUTH_DEV_MODE="1"

# ---- AI (outline builder + project briefs) ----
# Pick ONE provider. If both are set, DeepSeek wins (it's cheaper; swap them if you prefer).

# Anthropic Claude — https://console.anthropic.com → API Keys
# ANTHROPIC_API_KEY="sk-ant-..."

# DeepSeek — https://platform.deepseek.com → API Keys
# Cheaper than Anthropic, OpenAI-compatible API. Great for the outline builder.
DEEPSEEK_API_KEY="sk-..."

# Model override (optional — defaults shown)
# ANTHROPIC_MODEL="claude-sonnet-5"
# DEEPSEEK_MODEL="deepseek-chat"        # or "deepseek-reasoner" for heavier reasoning tasks

# ---- GoHighLevel (CRM sync) ----
# Get your Location API key from GHL: Settings → Business Profile → API Key.
# When set, leads from /start are auto-pushed to GHL as contacts.
# GHL_API_KEY="..."

# Optional — location ID for API calls (some setups need it, some don't)
# GHL_LOCATION_ID="..."

# Verification token for incoming GHL webhooks — set the same value in GHL
# Settings → Integrations → Webhooks → Add Webhook
# GHL_VERIFICATION_TOKEN="pick-a-random-secret"

# ---- Push notifications ----
# Generate VAPID keys: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY="..."
# VAPID_PRIVATE_KEY="..."
# VAPID_SUBJECT="mailto:michael.quinn0831@gmail.com"

# ---- Video hosting (Bunny.net Stream) ----
# BUNNY_STREAM_LIBRARY_ID="..."
# BUNNY_STREAM_API_KEY="..."
